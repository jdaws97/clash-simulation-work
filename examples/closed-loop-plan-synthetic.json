{
  "id": "synthetic-coupled-human-plan",
  "observation_interval_seconds": 0.25,
  "control_rules": {
    "observation_phase": "before_commands_and_hits",
    "stream_transition": "next_observation_after_command_resolution",
    "resource_contention": "due_time_then_action_id",
    "pending_cue": "latched_with_explicit_execution_recheck"
  },
  "failed_action_transition": "stop_stream",
  "resources": {
    "freeze_casts": 1
  },
  "streams": [
    {
      "id": "protect-charge",
      "steps": [
        {
          "all_conditions": [
            {
              "actor_id": "attacker",
              "field": "hp_fraction",
              "operator": "at_most",
              "value": 0.5
            },
            {
              "actor_id": "attacker",
              "field": "active",
              "operator": "equals",
              "value": true
            }
          ],
          "action": {
            "id": "protect",
            "kind": "freeze",
            "targets": [
              "tower"
            ],
            "duration_seconds": 2,
            "recheck_conditions_on_execution": true,
            "cost": {
              "freeze_casts": 1
            }
          }
        }
      ]
    }
  ]
}
