{
  "id": "synthetic-cue-plan",
  "observation_interpolation": "none",
  "concurrency_model": "independent_streams_joint_latency_trace",
  "missed_action_transition": "advance",
  "streams": [
    {
      "id": "setup-job",
      "steps": [
        {
          "all_conditions": [
            {
              "field": "target_matches",
              "operator": "equals",
              "value": true
            }
          ],
          "action": {
            "id": "setup",
            "kind": "hero_ability"
          }
        }
      ]
    },
    {
      "id": "main-job",
      "steps": [
        {
          "all_conditions": [
            {
              "field": "route_cleared",
              "operator": "equals",
              "value": true
            }
          ],
          "action": {
            "id": "entry",
            "kind": "deploy_main"
          }
        }
      ]
    }
  ]
}
