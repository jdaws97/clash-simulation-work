{
  "id": "synthetic-protect-breacher-then-follow-opening",
  "observation_interval_seconds": 0.05,
  "control_rules": {
    "observation_phase": "before_commands_and_hits",
    "stream_transition": "next_observation_after_command_resolution",
    "resource_contention": "due_time_then_action_id",
    "pending_cue": "latched_with_explicit_execution_recheck"
  },
  "failed_action_transition": "stop_stream",
  "resources": {
    "protection_cast": 1,
    "main_deployment": 1
  },
  "streams": [
    {
      "id": "protect",
      "steps": [
        {
          "all_conditions": [
            {
              "actor_id": "root",
              "field": "active",
              "operator": "equals",
              "value": true
            },
            {
              "actor_id": "root",
              "field": "hp_fraction",
              "operator": "at_most",
              "value": 0.65
            }
          ],
          "action": {
            "id": "protect-breacher",
            "kind": "area_freeze",
            "area": {
              "x": 11.5,
              "y": 5.5,
              "radius": 3.5,
              "target_team": "defense",
              "target_kinds": [
                "defense"
              ],
              "target_layers": [
                "ground"
              ]
            },
            "duration_seconds": 2,
            "recheck_conditions_on_execution": true,
            "cost": {
              "protection_cast": 1
            }
          }
        }
      ]
    },
    {
      "id": "follow-opening",
      "steps": [
        {
          "all_conditions": [
            {
              "actor_id": "wall-5",
              "field": "alive",
              "operator": "equals",
              "value": false
            },
            {
              "actor_id": "root",
              "field": "active",
              "operator": "equals",
              "value": true
            }
          ],
          "action": {
            "id": "deploy-followers",
            "kind": "deploy",
            "targets": [
              "follower-0",
              "follower-1",
              "follower-2"
            ],
            "positions": {
              "follower-0": {
                "x": 2.5,
                "y": 5.5
              },
              "follower-1": {
                "x": 1.5,
                "y": 5.5
              },
              "follower-2": {
                "x": 0.5,
                "y": 5.5
              }
            },
            "recheck_conditions_on_execution": true,
            "cost": {
              "main_deployment": 1
            }
          }
        }
      ]
    }
  ]
}
